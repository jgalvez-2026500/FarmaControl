<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefHeight="380.0" prefWidth="420.0" spacing="12.0" styleClass="root-login" stylesheets="@../resources/styles/LoginStyle.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.farmacontrol.system.controller.LoginController">
   <padding>
      <Insets bottom="30.0" left="50.0" right="50.0" top="30.0" />
   </padding>
   <children>
      <Label styleClass="titulo" text="FarmaControl" />
      <Label styleClass="subtitulo" />
      <Label styleClass="etiqueta" text="Usuario" />
      <TextField fx:id="nameField" onAction="#onInicioSesion" promptText="Nombre de usuario" />
      <Label styleClass="etiqueta" text="Contraseña" />
      <PasswordField fx:id="passwordField" onAction="#onInicioSesion" promptText="Contraseña" />
      <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#onInicioSesion" styleClass="btn-primario" text="Iniciar sesión" />
   </children>
</VBox>
